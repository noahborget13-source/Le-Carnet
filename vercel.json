{
  "version": 2,
  "crons": [
    { "path": "/api/cron-reminders", "schedule": "0 7 * * *" }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/maintenance.html",
      "permanent": false
    },
    {
      "source": "/((?!maintenance\\.html$|api/).*)",
      "destination": "/maintenance.html",
      "permanent": false
    }
  ]
}
